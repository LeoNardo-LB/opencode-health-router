{
  "name": "opencode-health-router",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.bundle.js",
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.bundle.js --sourcemap --keep-names --tree-shaking --external:@opencode-ai/plugin",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts __tests__/e2e/",
    "test:e2e:hook": "vitest run --config vitest.e2e.config.ts __tests__/e2e/plugin-lifecycle.test.ts",
    "test:e2e:serve": "npm run build && vitest run --config vitest.e2e.config.ts __tests__/e2e/mock-llm-e2e.test.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
